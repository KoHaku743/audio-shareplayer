{
  "name": "audio-shareplayer",
  "version": "1.0.0",
  "description": "Synchronized video/audio stream player – video on PC, audio on mobile. Supports HLS/MP4 URLs, torrent streaming, and Real-Debrid.",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "electron": "electron .",
    "electron:build": "electron-builder"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "express": "^4.18.2",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.0",
    "webtorrent": "^2.1.34"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.audio-shareplayer.app",
    "productName": "audio-shareplayer",
    "files": [
      "electron-main.cjs",
      "server.js",
      "public/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
